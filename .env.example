# WasteWise AI Environment Configuration
# Copy to .env and customize if needed. No API keys are required.

APP_NAME=WasteWise AI
APP_ENV=development
DATABASE_BACKEND=sqlite
SQLITE_DB_PATH=data/wastewise.db
MODEL_ARTIFACT_PATH=artifacts/demand_rf_model.joblib
MODEL_METADATA_PATH=artifacts/model_metadata.json
DATASET_CSV_PATH=data/synthetic_canteen_dataset.csv
DEFAULT_SAFETY_BUFFER_PCT=10.0
MIN_TRAINING_RECORDS=50
MIN_NEW_RECORDS_FOR_RETRAIN=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Future Supabase integration (not active in local SQLite mode)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Frontend production API base URL (optional; defaults to /api via Vite proxy in dev)
# VITE_API_BASE_URL=https://your-backend-host.example.com/api
